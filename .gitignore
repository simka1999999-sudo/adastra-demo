# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# sqlite
/prisma/*.db
/prisma/*.db-journal
/dev.db
*.db
*.db-journal

# static export stash (GitHub Pages build)
.export-stash/

# agent skill dumps
.claude/
.cursor/
.agents/
.windsurf/
skills-lock.json

# raw client drops (DropMeFiles originals)
/_client_drop/
/_audit/
